PORT=4000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/pc-care-sagar

# Generate a random secret of at least 32 characters
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=
# Set to the exact number of trusted reverse proxies in production; leave at 0 otherwise.
TRUST_PROXY_HOPS=0

EMAIL_FROM="P.C. Care Sagar <no-reply@pccaresagar.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
API_URL=http://localhost:4000

ADMIN_EMAIL=admin@pccaresagar.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password

ENQUIRY_NOTIFICATION_EMAIL=abhinandansoni100@gmail.com

# Checkout and payments
SHIPPING_CHARGE=0
STOCK_RESERVATION_MINUTES=15
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional WhatsApp notifications: choose "twilio" or "meta"
WHATSAPP_PROVIDER=
# Twilio (WHATSAPP_FROM can be omitted to use the number in website settings)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=
# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0